[user]
	email = xuliuchengxlc@gmail.com
	name = Liu-Cheng Xu
[core]
	excludesfile = /Users/xuliucheng/.gitexcludes
  # I have no idea why the python3 feature is broken when committing with vim
  editor       = nvim
	hooksPath = /Users/xuliucheng/.claude/git-hooks
[color "branch"]
  current   = bold green
  local     = yellow
  remote    = magenta
  upstream  = cyan
[color "status"]
  # staged changes
  added     = bold green
  updated   = green
  # un-staged changes
  changed   = yellow
  untracked = red
  nobranch  = red
[credential]
    helper = store
[gpg]
	format = ssh
[http "https://github.com"]
	proxy = socks5://127.0.0.1:7890
[url "git@github.com:"]
	insteadOf = https://github.com/
[gpg "ssh"]
	program = /Users/xuliucheng/.local/bin/yubikey-sign
# Signs by default here, so an unsigned commit fails instead of landing quietly;
# --no-gpg-sign skips one. Machine-local target, silently ignored if absent.
[includeIf "gitdir:~/src/github.com/babylonlabs-io/"]
	path = ~/.gitconfig-babylonlabs
