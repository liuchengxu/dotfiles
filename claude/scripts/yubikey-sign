#!/bin/bash
# Git SSH signing gate for the YubiKey (macOS side). Global gitconfig points
# gpg.ssh.program here; non-signing ssh-keygen operations pass through.
#
# Cancellation fails this signing attempt. Later explicit requests can prompt
# again. The YubiKey PIN, approval dialog, and tap remain required.

SSH_KEYGEN="/opt/homebrew/opt/openssh/bin/ssh-keygen"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yubikey-signing"
LOCK_DIR="$STATE_DIR/lock.d"
TOKEN="YUBIKEY_SIGNING_CANCELLED: user cancelled signing; stop this operation and wait for an explicit retry request"
EXIT_CANCELLED=97

is_sign=0 prev=""
for arg in "$@"; do
    [ "$prev" = "-Y" ] && [ "$arg" = "sign" ] && is_sign=1
    prev=$arg
done
[ "$is_sign" = 1 ] || exec "$SSH_KEYGEN" "$@"

(umask 077; mkdir -p "$STATE_DIR")

# One dialog at a time: mkdir is the atomic lock. A lock whose recorded pid
# is dead is reclaimed, covering SIGKILL where the EXIT trap can't run.
while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    owner=$(cat "$LOCK_DIR/pid" 2>/dev/null)
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
        rm -rf "$LOCK_DIR"
        continue
    fi
    if [ "$SECONDS" -ge 180 ]; then
        echo "yubikey-sign: timed out waiting for another signing dialog" >&2
        exit 1
    fi
    sleep 0.2
done
echo $$ > "$LOCK_DIR/pid"
trap 'rm -rf "$LOCK_DIR"' EXIT

MARKER="$LOCK_DIR/cancelled"

SSH_AUTH_SOCK= \
SSH_ASKPASS="$HOME/.local/bin/ssh-askpass" \
SSH_ASKPASS_REQUIRE=force \
YUBIKEY_SIGN_CANCEL_MARKER="$MARKER" \
"$SSH_KEYGEN" "$@"
rc=$?

if [ "$rc" -ne 0 ] && [ -e "$MARKER" ]; then
    echo "$TOKEN" >&2
    exit "$EXIT_CANCELLED"
fi
exit "$rc"
