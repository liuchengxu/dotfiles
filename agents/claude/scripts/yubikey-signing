#!/bin/bash
# Compatibility command. Signing cancellation is no longer persistent.

case "${1:-status}" in
  status|enable)
    echo "signing uses per-attempt approval; no enable command is required"
    ;;
  disable)
    echo "persistent signing disable is no longer supported; cancel the signing dialog" >&2
    exit 2
    ;;
  *)
    echo "usage: yubikey-signing [status]" >&2
    exit 2
    ;;
esac
