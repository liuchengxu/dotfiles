#!/usr/bin/env python3
"""Print the stored YubiKey PIN, or nothing. Client of yubikey-keychain-agent.

ssh-askpass calls this when its own keychain lookup fails, which happens for
every signing started over SSH.
"""
import os
import socket
import sys

PATH = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "yubikey-signing", "keychain.sock")

try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(10)
        client.connect(PATH)
        client.shutdown(socket.SHUT_WR)
        sys.stdout.write(client.recv(4096).decode())
except OSError:
    pass
