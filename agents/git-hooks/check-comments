#!/usr/bin/env bash
# An opt-in audit (COMMENT_CHECK=1) that asks a model whether the comments a
# commit adds earn their place (comment-rule.md). Runs only when the staged
# change adds comment lines, and only when asked: the write-time gate and the
# review pass own comment hygiene day to day.
set -u

# Opt-in audit of the comments a commit would add, judged against
# comment-rule.md. Off by default: comment hygiene is enforced where comments
# are written (the code-minimalism skill's write-time gate) and re-checked by
# the review pass before a PR; running a model session inside every commit
# cost more than it caught. Run deliberately: COMMENT_CHECK=1 git commit.
[ "${COMMENT_CHECK:-}" = 1 ] || exit 0
dir=$(cd "$(dirname "$0")" && pwd -P)
model=${COMMENT_CHECK_MODEL:-deepseek/deepseek-flash}
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Added comment lines: //, /*, or # (not a Rust attribute or a shebang).
# Prose and data files are not code.
git diff --cached -U0 --no-color -- . ':!*.md' ':!*.txt' ':!*.lock' ':!*.json' |
  awk '/^\+\+\+ b\// { f = substr($0, 7); next }
       /^\+[[:space:]]*(\/\/|\/\*|#([^[!]|$))/ { print f }' | sort -u |
  while read -r file; do
    git diff --cached -U3 --no-color -- "$file"
  done > "$tmp/diff"

[ -s "$tmp/diff" ] || exit 0

echo "comment check: asking $model about the added comments..." >&2
out=$(cd "$top" && perl -e 'alarm shift; exec @ARGV' "${COMMENT_CHECK_TIMEOUT:-90}" \
  pi -p --no-session --model "$model" --tools read,grep,find,ls \
  "$(cat "$dir/comment-rule.md")

The diff to check is in $tmp/diff." < /dev/null 2> "$tmp/err")
status=$?

verdict=$(printf '%s\n' "$out" | awk 'NF { print $1; exit }')
case $verdict in
  PASS) exit 0 ;;
  FAIL)
    {
      echo "comment check ($model) blocked the commit:"
      printf '%s\n' "$out" | awk 'NF' | sed 1d
      echo
      echo "Fix these comments, stage them, and commit again."
      echo "To skip this deliberate audit: git commit --no-verify ..."
    } >&2
    exit 1
    ;;
  *)
    # A deliberate audit must not pass on a shrug: with no verdict the audit
    # is incomplete, so the commit stops. Rerun it, or --no-verify to skip.
    echo "comment check: no verdict from $model (exit $status); audit incomplete." >&2
    exit 1
    ;;
esac
